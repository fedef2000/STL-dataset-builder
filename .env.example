# Copy this file to .env and fill in your values. .env is gitignored.

# Your email: identifies you to OpenAlex and arXiv (polite pool)
USER_EMAIL=

# Optional: free key from openalex.org, raises the daily quota
OPENALEX_API_KEY=

# Optional: key from semanticscholar.org/product/api, lifts the anonymous rate limit
SEMANTIC_SCHOLAR_API_KEY=
